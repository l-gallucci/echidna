# Echidna MAG QC. Heavy tools run in separate conda environments.
# Assembly cleaning is provided by `echidna misassembly-wf`, not this DAG.
import os
import shlex
from pathlib import Path

configfile: os.path.join(workflow.basedir, "config.yaml")

GENOMES = str(config["genomes_dir"])
EXT = str(config["genome_ext"]).lstrip(".")
OUT = str(config["outdir"])
THREADS = int(config["threads"])
# Track individual FASTAs: editing a file need not update its parent directory.
GENOME_FILES = sorted(str(p) for p in Path(GENOMES).glob(f"*.{EXT}") if p.is_file())
if not GENOME_FILES:
    raise ValueError(f"No genomes matching *.{EXT} in {GENOMES}")
if THREADS < 1:
    raise ValueError("threads must be positive")

USE_NAMED = bool(config.get("use_named_envs", False))
ENVS = {role: config.get("env_" + role, "")
        for role in ("echidna", "checkm2", "gtdbtk", "gunc", "mimag")}
MIMAG_RNA = bool(config.get("mimag_rna", False))
MIMAG_KING = config.get("mimag_kingdom", "bac")


def pre(role):
    # Unspecified roles use PATH, retaining the mixed named-env/PATH mode.
    name = ENVS.get(role, "")
    return "conda run -n " + shlex.quote(name) + " " if USE_NAMED and name else ""


rule all:
    input:
        f"{OUT}/chimera_report.tsv",
        f"{OUT}/organized/merged_quality.tsv",
        f"{OUT}/organized/Selected",


rule all_mag_quality:
    input:
        rules.all.input


rule run_checkm2:
    input:
        genomes=GENOME_FILES,
    output:
        outdir=directory(f"{OUT}/checkm2"),
    params:
        pre=pre("checkm2"),
        db=("--database " + shlex.quote(str(config["checkm2_db"]))) if config.get("checkm2_db") else "",
    threads: THREADS
    conda:
        "envs/checkm2.yaml"
    shell:
        "{params.pre}echidna run-checkm2 --genome-dir {GENOMES:q} --output {output.outdir:q} "
        "--extension {EXT:q} --threads {threads} --force {params.db}"


rule run_gtdbtk:
    input:
        genomes=GENOME_FILES,
    output:
        outdir=directory(f"{OUT}/gtdbtk"),
    params:
        pre=pre("gtdbtk"),
        skip=("--skip-existing" if config.get("gtdbtk_skip_existing", True) else ""),
    threads: THREADS
    conda:
        "envs/gtdbtk.yaml"
    shell:
        "GTDBTK_DATA_PATH={config[gtdbtk_data]:q} "
        "{params.pre}echidna run-gtdbtk --genome-dir {GENOMES:q} --output {output.outdir:q} "
        "--extension {EXT:q} --cpus {threads} {params.skip}"


rule run_gunc:
    input:
        genomes=GENOME_FILES,
    output:
        outdir=directory(f"{OUT}/gunc"),
    params:
        pre=pre("gunc"),
    threads: THREADS
    conda:
        "envs/gunc.yaml"
    shell:
        "{params.pre}echidna run-gunc --genome-dir {GENOMES:q} --output {output.outdir:q} "
        "--file-suffix .{EXT:q} --threads {threads} --db-file {config[gunc_db]:q}"


rule run_mimag_rna:
    input:
        genomes=GENOME_FILES,
    output:
        outdir=directory(f"{OUT}/mimag_rna"),
    params:
        pre=pre("mimag"),
    threads: THREADS
    conda:
        "envs/mimag.yaml"
    shell:
        "{params.pre}echidna run-mimag-rna --genome-dir {GENOMES:q} --output {output.outdir:q} "
        "--extension {EXT:q} --kingdom {MIMAG_KING:q} --threads {threads}"


def organize_inputs(_):
    inputs = {"checkm2": f"{OUT}/checkm2", "gtdbtk": f"{OUT}/gtdbtk",
              "genomes": GENOME_FILES}
    if MIMAG_RNA:
        inputs["mimag"] = f"{OUT}/mimag_rna"
    return inputs


rule organize_mags:
    input:
        unpack(organize_inputs),
    output:
        merged=f"{OUT}/organized/merged_quality.tsv",
        # Snakemake must remove old tier copies when it reruns this rule.
        selected=directory(f"{OUT}/organized/Selected"),
    params:
        pre=pre("echidna"),
        outdir=f"{OUT}/organized",
        mimag=("--mimag-rna-dir " + shlex.quote(f"{OUT}/mimag_rna")) if MIMAG_RNA else "",
    conda:
        "envs/echidna.yaml"
    shell:
        "{params.pre}echidna organize-mags --checkm2-root {input.checkm2:q} "
        "--genomes-dir {GENOMES:q} --gtdbtk-dir {input.gtdbtk:q} "
        "--output {params.outdir:q} --rename --copy "
        "--sample-regex {config[sample_regex]:q} --tax-level {config[tax_level]:q} "
        "--extensions {EXT:q} {params.mimag}"


rule check_chimeras:
    input:
        checkm2=f"{OUT}/checkm2",
        gtdbtk=f"{OUT}/gtdbtk",
        gunc=f"{OUT}/gunc",
        genomes=GENOME_FILES,
    output:
        report=f"{OUT}/chimera_report.tsv",
    params:
        pre=pre("echidna"),
        report=f"{OUT}/checkm2/quality_report.tsv",
    conda:
        "envs/echidna.yaml"
    shell:
        "{params.pre}echidna check-chimeras --bins-dir {GENOMES:q} --output {output.report:q} "
        "--gtdbtk-dir {input.gtdbtk:q} --checkm2-report {params.report:q} "
        "--gunc-dir {input.gunc:q} --extensions {EXT:q}"
